<Window x:Class="CybersecurityChatbotPart2.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity Log" Height="420" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F7">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📜 Activity Log"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Log list -->
        <Grid Grid.Row="1">
            <ListBox x:Name="LstLog" Margin="0,0,0,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="2,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state message -->
            <TextBlock x:Name="TxtEmpty"
                       Text="No activity recorded yet. Add a task or start a quiz first."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#999" FontStyle="Italic"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnRefresh" Content="🔄 Refresh" Width="90"
                    Padding="6,4" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnClear" Content="🗑 Clear" Width="90"
                    Padding="6,4" Margin="8,0,0,0" Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</Window>
